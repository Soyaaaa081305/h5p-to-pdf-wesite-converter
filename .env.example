# Optional model override; the default is Gemini 3.8 Flash.
VITE_GEMINI_MODEL=gemini-3.8-flash

# Optional: a restricted YouTube Data API key for in-app search.
# Without it, search opens YouTube in a new tab and accepts a pasted video URL.
VITE_YOUTUBE_API_KEY=

# Public deployed URL used by the bookmarklet.
VITE_APP_BASE_URL=https://h5p-to-pdf-converter.web.app/
